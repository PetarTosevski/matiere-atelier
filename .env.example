NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONVEX_URL=               # deployment URL; npx convex dev writes it to .env.local
CONVEX_SERVER_SECRET=     # long random string; also set in Convex (npx convex env set)
ADMIN_USERNAME=           # the admin's email address (sign-in name, and where reset links go)
ADMIN_PASSWORD_HASH=      # from npm run hash-password
SESSION_SECRET=           # at least 32 random characters
ALLOW_INDEXING=           # "true" at launch lets search engines in; anything else keeps them out
SITE_LOCKED=              # "true" shows visitors the "Opening soon" page (/admin stays open); unset at launch, then redeploy
SITE_PREVIEW_TOKEN=       # long random string: /?preview=<token> shows that browser the real site; /?preview=off undoes it
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                # studio@: sender of every email except account emails, e.g. "Matière <studio@...>"
MAIL_FROM_NOREPLY=        # optional: sender of account emails (verification, password resets, account deleted); a Gmail "Send mail as" alias; falls back to MAIL_FROM
MAIL_FROM_INQUIRIES=      # optional: sender of the inquiry email to the artist, e.g. "Matière <inquiries@...>" (for inbox filters); a Gmail "Send mail as" alias; falls back to MAIL_FROM
MAIL_FROM_NEWSLETTER=     # optional: sender of the new-work email to subscribers, e.g. "Matière <newsletter@...>"; a Gmail "Send mail as" alias; falls back to MAIL_FROM
MAIL_TO=                  # where inquiries arrive: inquiries@
NEXT_PUBLIC_TURNSTILE_SITE_KEY=  # Cloudflare Turnstile (bot check on the forms); unset turns it off. Test key that always passes: 1x00000000000000000000AA
TURNSTILE_SECRET_KEY=            # its secret; test secret that always passes: 1x0000000000000000000000000000000AA
